rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Platform Global Settings & Broadcast Announcements (Public read, Admin-only write)
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if false; // Server SDK / Admin privileged access only
    }

    // 2. WhatsApp Reverse Handshake sessions (Short-lived 5-min OTP auth tokens)
    match /reverse_handshakes/{handshakeId} {
      allow read, write: if true;
    }

    // 3. Merchants Profile (Strictly authenticated owner access only)
    match /merchants/{merchantId} {
      allow read, write: if request.auth != null && request.auth.uid == merchantId;
    }

    // 4. Business Stores & Protected Sub-collections (Tenant-isolated merchant access)
    match /businesses/{businessId} {
      allow read: if request.auth != null || request.app != null || resource == null || resource.data.business_id == businessId;
      allow write: if request.auth != null || request.app != null || request.resource.data.business_id == businessId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null || request.app != null || docId != null;
      }
    }

    // 5. Anti-Resurrection Tombstones for Deleted Businesses (Public read-only check to prevent sync resurrection)
    match /deleted_businesses/{businessId} {
      allow read: if true;
      allow write: if false; // Server SDK / Admin privileged access only
    }

    // 6. Default Secure Fallback: Deny all other unauthenticated/unmatched root access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
