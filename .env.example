# ==============================================================================
# KamaiPlus Production & Development Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Authentication Secrets (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# 32+ character random string for merchant staff session JWT tokens
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# 32+ character random string for SuperAdmin access tokens
ADMIN_JWT_SECRET=your_superadmin_jwt_secret_key_minimum_32_characters

# Strong master password for accessing the /admin dashboard
ADMIN_PASSWORD=your_strong_production_admin_password

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (MANDATORY FOR ONLINE SUBSCRIPTIONS)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API (OPTIONAL / PURCHASE OCR SCANNER)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key

# ------------------------------------------------------------------------------
# 4. Meta WhatsApp Cloud API (FOR BILL DISPATCH & OTP)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_permanent_system_user_token
WHATSAPP_VERIFY_TOKEN=kamaiplus_verify_token_2026
# Optional: For X-Hub-Signature-256 webhook payload verification
WHATSAPP_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------------------
# 5. Firebase Cloud Sync & Storage
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCXq5B7MdPcaa48HpRATpMZbCW-K2vCtb0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kamaiplus.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kamaiplus
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kamaiplus.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1241090505753953
NEXT_PUBLIC_FIREBASE_APP_ID=1:1241090505753953:web:kamaiplus
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key

# ------------------------------------------------------------------------------
# 6. Supabase Cloud Database & Auth (Optional Cloud Storage Backend)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dgolzwqlalbelvsxqzci.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
